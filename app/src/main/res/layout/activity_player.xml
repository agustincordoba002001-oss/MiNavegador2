<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Reproductor ExoPlayer al fondo -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra superior de controles flotantes -->
    <LinearLayout
        android:id="@+id/topBarControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical|end"
        android:background="#B3000000"
        android:elevation="10dp"
        android:layout_alignParentTop="true">

        <Button
            android:id="@+id/btnPasteM3u"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pegar M3U"
            android:textColor="@android:color/white"
            android:backgroundTint="#3F51B5"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnListM3u8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M3U8"
            android:textColor="@android:color/white"
            android:backgroundTint="#00897B"
            android:layout_marginStart="4dp"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnDownloadVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descargar"
            android:textColor="@android:color/white"
            android:backgroundTint="#D81B60"
            android:layout_marginStart="4dp"
            android:textSize="10sp" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/mediaRouteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="32dp"
            android:minHeight="32dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnScanDlna"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conectar TV"
            android:textColor="@android:color/white"
            android:backgroundTint="#6200EE"
            android:layout_marginStart="4dp"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Panel contenedor fijo para la lista M3U8 analizada -->
    <LinearLayout
        android:id="@+id/panelM3u8List"
        android:layout_width="320dp"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:background="#CC111111"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPanelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lista / Calidades M3U8"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnClosePanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X"
                android:minWidth="32dp"
                android:minHeight="32dp"
                android:textSize="10sp"
                android:backgroundTint="#D32F2F"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <ListView
            android:id="@+id/listViewM3u8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#44FFFFFF"
            android:dividerHeight="1dp"
            android:scrollbars="vertical" />
    </LinearLayout>

</RelativeLayout>