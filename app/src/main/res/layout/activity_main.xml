<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#2563EB">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ MiNavegador"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/blockedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 bloqueados"
            android:textColor="#BFDBFE"
            android:textSize="13sp"
            android:background="#1E40AF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#F1F5F9"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:hint="Buscar o escribir URL..."
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textUri" />

        <Button
            android:id="@+id/goButton"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="IR"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#DBEAFE">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Protección Activa"
            android:textColor="#1E40AF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EasyList PRO • Sin rastreadores"
            android:textColor="#1E40AF"
            android:textSize="12sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="◀ Atrás"
            android:background="@android:color/transparent"
            android:textColor="#334155" />

        <Button
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Adelante ▶"
            android:background="@android:color/transparent"
            android:textColor="#334155" />

        <Button
            android:id="@+id/reloadButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="↻ Recargar"
            android:background="@android:color/transparent"
            android:textColor="#334155" />

        <Button
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="⌂ Inicio"
            android:background="@android:color/transparent"
            android:textColor="#2563EB" />
    </LinearLayout>
</LinearLayout>