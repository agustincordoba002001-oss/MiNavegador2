<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Barra superior de navegación (URL y Botones) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1F1F1F"
        android:gravity="center_vertical">

        <!-- Campo de texto de URL (ID EXACTO: etUrl) -->
        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Escribe o pega una URL..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:background="@android:drawable/editbox_background_normal"
            android:paddingHorizontal="8dp" />

        <!-- Botón Ir -->
        <Button
            android:id="@+id/btnGo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Ir"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Fila de Botones de Acción (Biblioteca y Extracción Masiva) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1A1A1A"
        android:gravity="center">

        <!-- Botón Biblioteca -->
        <Button
            android:id="@+id/btnLibrary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📂 Biblioteca"
            android:backgroundTint="#673AB7"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <!-- Botón de Extracción Masiva Automática -->
        <Button
            android:id="@+id/btnExtractAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Extraer Todos"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- WebView (El navegador web integrado) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>