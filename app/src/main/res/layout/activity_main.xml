<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Barra superior de navegación (URL y Botones) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1F1F1F"
        android:gravity="center_vertical">

        <!-- Campo de texto de URL (ID EXACTO: etUrl) -->
        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Escribe o pega una URL..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:background="@android:drawable/editbox_background_normal"
            android:paddingHorizontal="8dp" />

        <!-- Botón Ir -->
        <Button
            android:id="@+id/btnGo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Ir"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Fila 1 de Botones de Acción (Reproducir en App y Videos Detectados) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:background="#1A1A1A"
        android:gravity="center">

        <!-- Botón Directo Reproducir Video de la Página -->
        <Button
            android:id="@+id/btnPlayCurrentVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="▶ Reproducir en App"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <!-- Botón Videos Detectados (Estilo Videocaster) -->
        <Button
            android:id="@+id/btnDetectedVideos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎬 Videos (0)"
            android:backgroundTint="#FF6D00"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Fila 2 de Botones de Acción (Analizar M3U, Biblioteca y Extraer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:background="#1A1A1A"
        android:gravity="center">

        <!-- Botón Analizador M3U / M3U8 -->
        <Button
            android:id="@+id/btnM3uAnalyzer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 Analizar M3U"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="2dp" />

        <!-- Botón Biblioteca -->
        <Button
            android:id="@+id/btnLibrary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📂 Biblioteca"
            android:backgroundTint="#673AB7"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginHorizontal="2dp" />

        <!-- Botón Extraer Todos -->
        <Button
            android:id="@+id/btnExtractAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Extraer"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginStart="2dp" />

    </LinearLayout>

    <!-- WebView (El navegador web integrado) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
